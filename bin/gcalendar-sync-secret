#!/usr/bin/env bash
# gcalendar-sync-secret ACCOUNT id|secret — print one half of the stored OAuth client on stdout.
#
# Called by vdirsyncer through `client_id.fetch` / `client_secret.fetch`, so neither
# is ever in its config file or in a process's arguments. Refuses files that others could read.
set -euo pipefail
umask 077
die() { printf 'gcalendar-sync-secret: %s\n' "$*" >&2; exit 1; }
[[ $# -eq 2 && $2 =~ ^(id|secret)$ ]] || die "usage: gcalendar-sync-secret ACCOUNT id|secret"
acct=$1
[[ $acct =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || die "invalid account name"
conf_root=${GCALENDAR_SYNC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gcalendar-sync}
dir=$conf_root/$acct
check_private() {
    local p=$1 owner mode
    [[ ! -L $p && -e $p ]] || die "$p is missing or a symlink; refusing"
    read -r owner mode < <(stat -c '%u %a' -- "$p")
    [[ $owner == "$(id -u)" ]] || die "$p is not owned by you"
    (( (8#$mode & 8#077) == 0 )) || die "$p has mode $mode; remove group/other access (chmod go= '$p')"
}
check_private "$conf_root"; check_private "$dir"; check_private "$dir/client.cred"
# --name binds the blob to this account and purpose.
out=$(systemd-creds --user --name="gcalendar-sync-client-$acct" --newline=no decrypt "$dir/client.cred" -)
case $2 in id) printf '%s\n' "${out%%$'\n'*}" ;; secret) printf '%s\n' "${out#*$'\n'}" ;; esac
