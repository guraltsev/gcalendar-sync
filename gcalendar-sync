#!/usr/bin/env bash
# gcalendar-sync — Google Calendar <-> folders of .ics files with vdirsyncer, plus a
# git-versioned backup of every state. The sibling of gmail-sync; see README.md.
set -euo pipefail
umask 077

PROG=gcalendar-sync
SELF_DIR=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
# In a checkout the helper is in bin/; installed, it is next to this program.
HELPER=$SELF_DIR/gcalendar-sync-secret
[[ ! -f $SELF_DIR/bin/gcalendar-sync-secret ]] || HELPER=$SELF_DIR/bin/gcalendar-sync-secret
VDIRSYNCER=${VDIRSYNCER:-vdirsyncer}

CONF_ROOT=${GCALENDAR_SYNC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gcalendar-sync}
STATE_ROOT=${GCALENDAR_SYNC_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/gcalendar-sync}
DEFAULT_ROOT=${GCALENDAR_SYNC_CALENDARS:-$HOME/Documents/Calendars}
RUN_ROOT=${GCALENDAR_SYNC_RUNTIME:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gcalendar-sync}
UNIT_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
# Tests only: a folder that stands in for Google.
TEST_REMOTE=${GCALENDAR_SYNC_TEST_REMOTE:-}

die()  { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
info() { printf '%s: %s\n' "$PROG" "$*"; }

usage() {
    cat <<'EOT'
usage: gcalendar-sync COMMAND [ACCOUNT] [ARGS]

Program
  install                 install or upgrade for this user; run it from a checkout
  uninstall               turn the timers off and list the installed files to delete

Setup
  init ACCOUNT --email ADDR [--calendars DIR] [--backup-git DIR] [--backup-remote URL]
               [--file-mode 640] [--dir-mode 750]
                          create an account (refuses existing calendars or backups)
  recover ACCOUNT --email ADDR [init's options]
                          set an account up again on calendars and a backup still on disk
  set-client ACCOUNT [--stdin]
                          store the Google OAuth client id and secret, encrypted
  authorize ACCOUNT       sign in to Google in the browser; the token is stored encrypted
  list-calendars ACCOUNT  the calendars Google offers: id and name
  add ACCOUNT NAME ID [both|pull]
                          sync calendar ID in the folder NAME (default pull: read-only)
  remove ACCOUNT NAME     stop syncing it (its files, backup and Google calendar stay)
  regen ACCOUNT           apply edits made to account.conf or calendars.conf
  move ACCOUNT [--calendars DIR] [--backup-git DIR]
                          move the calendars and/or backup and update the settings
  accounts                list the accounts

Sync
  sync ACCOUNT [--force]  back up, sync every calendar, back up again
                          (--force overrides the mass-deletion guards)
  sync ACCOUNT --quick    only two-way calendars with local changes; none: do nothing
  status [ACCOUNT]

Backup (git)
  backup ACCOUNT          commit the current state now (and push)
  history ACCOUNT [N]     the last N backup commits (default 20)
  restore ACCOUNT DEST [--at DATE | --rev REV]
                          export the calendars as they were into a new folder DEST
  git ACCOUNT ARGS...     run any git command on the backup repository
  maint ACCOUNT           git gc + fsck + push

Scheduling (systemd --user)
  enable-timers ACCOUNT   full sync every 5 minutes, quick sync when a file changes,
                          maintenance weekly
  disable-timers ACCOUNT
  timers [ACCOUNT]
  log ACCOUNT [JOURNALCTL-ARGS...]

Of one command:  gcalendar-sync help COMMAND   or   gcalendar-sync COMMAND --help
EOT
}

